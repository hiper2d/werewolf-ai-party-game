rules_version = '2';

// Browsers read nothing and write nothing directly: every read and write goes through the
// server (firebase-admin, which these rules do not apply to). The per-seat read rules for
// live game updates (docs/plan-multiplayer.md, Design §1-2) are added here when the
// listeners are built; until then a signed-in browser (firebase/client.ts) is refused too.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
